{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "mobile",
	"description": "Tablet UI with access to application-private storage only",
	"platforms": ["android", "iOS"],
	"windows": ["main", "doc-*"],
	"permissions": [
		"core:default",
		"opener:default",
		"fs:default",
		"fs:allow-read-dir",
		"fs:allow-read-file",
		"fs:allow-read-text-file",
		"fs:allow-write-text-file",
		"fs:allow-write-file",
		"fs:allow-mkdir",
		"fs:allow-remove",
		"fs:allow-rename",
		"fs:allow-stat",
		"fs:allow-lstat",
		"fs:allow-exists",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$APPCACHE" },
				{ "path": "$APPCACHE/**" }
			]
		},
		"dialog:default",
		"log:default"
	]
}
